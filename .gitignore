```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo

# Audio files (build artifacts)
*.wav

# Logs and temp files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/
```